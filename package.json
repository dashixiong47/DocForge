{
  "name": "docforge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "secrets:push": "node tools/push-dev-vars-secrets.mjs",
    "db:init": "node tools/migrate-d1.mjs --local",
    "db:migrate:remote": "node tools/migrate-d1.mjs --remote",
    "deploy:local": "npm run secrets:push && npm run db:migrate:remote && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250303.0",
    "drizzle-kit": "^0.30.4",
    "playwright": "^1.60.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.1"
  }
}
